# Application
PRODUCTION=                 # Please set to exactly "true" before compiling for production.
APP_PORT=                   # 8080

# Database
DB_DRIVER=                  # mariadb / mysql / postgresql
DB_HOST=                    # 127.0.0.1
DB_PORT=                    # 3306
DB_USER=                    # roto
DB_PASSWORD=                # roto123
DB_NAME=                    # my_database

# Prisma
SHADOW_DATABASE=            # my_database_shadow

# Build
OS=                         # linux / windows / darwin
ARCH=                       # amd64 / arm64

# Connection Pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1800
DB_CONN_MAX_IDLE_TIME=300

# MySQL / MariaDB
MARIADB_CHARSET=utf8mb4
MARIADB_LOC=                # Asia/Jakarta
MARIADB_TLS=false

# PostgreSQL
POSTGRES_SSLMODE=disable
POSTGRES_TIMEZONE=          # Asia/Jakarta

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=